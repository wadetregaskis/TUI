observed | two scopes, same animation: ["-- turn ends --", "a=1 b=1 c=0 T1", "a=1 b=1 c=0 plain"]
observed | two scopes, different animations: ["a=1 b=0 c=0 T1", "-- turn ends --", "a=1 b=1 c=0 T2", "a=1 b=1 c=0 plain"]
observed | three writes in one scope: ["-- turn ends --", "a=1 b=1 c=1 T1", "a=1 b=1 c=1 plain"]
observed | nested, outer write, inner write, outer write: ["a=1 b=0 c=0 T1", "a=1 b=1 c=0 T2", "-- turn ends --", "a=1 b=1 c=1 T1", "a=1 b=1 c=1 plain"]
observed | plain a, then plain b: ["-- turn ends --", "a=1 b=1 c=0 plain"]
observed | plain a, a scope that only reads, then plain b: ["-- turn ends --", "a=1 b=1 c=0 plain"]
observed | plain a, then a scope with no animation: ["a=1 b=0 c=0 plain", "-- turn ends --", "a=1 b=1 c=0 plain", "a=1 b=1 c=0 plain"]
observed | plain a, animated c that no value changes (same value): ["-- turn ends --", "a=1 b=0 c=0 plain"]
state    | plain a, then animated b: ["-- turn ends --", "body a=1 b=0", "a=1 b=0 plain", "body a=1 b=1", "a=1 b=1 T1", "a=1 b=1 plain"]
state    | animated b, then plain a: ["-- turn ends --", "body a=0 b=1", "a=0 b=1 T1", "body a=1 b=1", "a=1 b=1 plain"]
state    | animated b only: ["-- turn ends --", "body a=0 b=1", "a=0 b=1 T1", "a=0 b=1 plain"]
state    | plain a only: ["-- turn ends --", "body a=1 b=0", "a=1 b=0 plain"]
state    | plain a, then empty withAnimation: ["-- turn ends --", "body a=1 b=0", "a=1 b=0 plain"]
state    | two scopes, same animation: ["-- turn ends --", "body a=1 b=1", "a=1 b=1 T1", "a=1 b=1 plain"]
state    | reads its own writes: plain a, scope reads: ["read in scope (1, 0)", "read after write (1, 1)", "-- turn ends --", "body a=1 b=0", "a=1 b=0 plain", "body a=1 b=1", "a=1 b=1 T1", "a=1 b=1 plain"]
values   | plain a, then animated b: a: [] b: ["b=0", "b=between"]
values   | animated b, then plain a: a: [] b: ["b=0", "b=between"]
bodies   | plain a, then animated b: ["a=1 plain", "-- turn ends --", "b=1 T1", "a=1 T1", "b=1 plain"]
bodies   | animated b, then plain a: ["b=1 T1", "-- turn ends --", "b=1 plain", "a=1 plain"]
changes  | plain a, then animated b: ["onChange a -> 1 (b=0)", "-- turn ends --", "onChange b -> 1 (a=1)"]
changes  | animated b, then plain a: ["onChange b -> 1 (a=0)", "-- turn ends --", "onChange a -> 1 (b=1)"]
changes  | completion, scope wrote nothing, a plain change pending: ["completion", "after the scope", "-- turn ends --", "onChange a -> 1 (b=0)"]
changes  | completion, scope wrote b, a plain change pending: ["onChange a -> 1 (b=0)", "after the scope", "-- turn ends --", "onChange b -> 1 (a=1)", "completion"]
changes  | completion, scope wrote b, nothing pending: ["after the scope", "-- turn ends --", "onChange b -> 1 (a=0)", "completion"]
