springing.delay default = 0.5
springing.enabled default = 1
env[root] springLoadingBehavior = automatic
[env-root] no AppKit control; classes: CGDrawingView, NSHostingView<EnvReader>
[env-root] hosting responds to springLoadingEntered: true; conforms NSSpringLoadingDestination: false
env[set enabled] springLoadingBehavior = enabled
[env-enabled] no AppKit control; classes: CGDrawingView, NSHostingView<ModifiedContent<ModifiedContent<EnvReader, _EnvironmentKeyWritingModifier<SpringLoadingBehavior>>, ViewInputFlagModifier<HasCustomSpringLoadedBehavior>>>
[env-enabled] hosting responds to springLoadingEntered: true; conforms NSSpringLoadingDestination: false
env[inner enabled] springLoadingBehavior = enabled
[env-nested] no AppKit control; classes: CGDrawingView, NSHostingView<ModifiedContent<ModifiedContent<VStack<ModifiedContent<ModifiedContent<EnvReader, _EnvironmentKeyWritingModifier<SpringLoadingBehavior>>, ViewInputFlagModifier<HasCustomSpringLoadedBehavior>>>, _EnvironmentKeyWritingModifier<SpringLoadingBehavior>>, ViewInputFlagModifier<HasCustomSpringLoadedBehavior>>>
[env-nested] hosting responds to springLoadingEntered: true; conforms NSSpringLoadingDestination: false
env[inner inherits] springLoadingBehavior = disabled
[env-nested2] no AppKit control; classes: CGDrawingView, NSHostingView<ModifiedContent<ModifiedContent<VStack<EnvReader>, _EnvironmentKeyWritingModifier<SpringLoadingBehavior>>, ViewInputFlagModifier<HasCustomSpringLoadedBehavior>>>
[env-nested2] hosting responds to springLoadingEntered: true; conforms NSSpringLoadingDestination: false
