a ^[x](a: (1)) b                   -> "a x b"
a ^[x](a: (1) b                    -> "a ^[x](a: (1) b"
a ^[x](a: 1)) b                    -> "a x) b"
a ^[x](a: "(") b                   -> "a ^[x](a: \"(\") b"
a ^[x](a: ")") b                   -> "a x\") b"
a ^[x](a: \)) b                    -> "a x b"
a ^[x](a:
1) b                     -> "a x b"
a ^[x
](a: 1) b                    -> "a x\n b"
a ^[x](<a: 1>) b                   -> "a x b"
a ^[[y]](a: 1) b                   -> "a [y] b"
a ^[x](a: 1 "t") b                 -> "a x b"
a ^[x](inflect: true) b            -> "a x b"
a ^[x](garbage) b                  -> "a x b"
a ^[x]() b                         -> "a x b"
a ^[x](a:) b                       -> "a x b"
a ^[x]({a: 1}) b                   -> "a x b"
a ^[x](a: 1,) b                    -> "a x b"
a ^[x](a 1) b                      -> "a x b"
a ^[x](a: 1 b: 2) b                -> "a x b"
a ^[x]("a": 1) b                   -> "a x b"
a ^[x](a: [1, 2]) b                -> "a x b"
a ^[x](a: {b: 1}) b                -> "a x b"
a ^[x](a: 'q') b                   -> "a x b"
a ^[x](a: undefined) b             -> "a x b"
a ^[x](a: 1)(b: 2) b               -> "a x(b: 2) b"
a ^[x](a: 1 b                      -> "a ^[x](a: 1 b"
a ^[x] (a: 1) b                    -> "a ^[x] (a: 1) b"
a ^[x](a: "unterminated) b         -> "a x b"
a ^[x](1) b                        -> "a x b"
a ^[x](a: 1}) b                    -> "a x b"
a ^[x](/* c */ a: 1) b             -> "a x b"
a ^[x](a: NaN) b                   -> "a x b"
a ^[x](a: Infinity) b              -> "a x b"
a ^[x](a: 0x1F) b                  -> "a x b"
a ^[x](a: .5) b                    -> "a x b"
a ^[x](a: +1) b                    -> "a x b"
a ^[x](a: 1e3) b                   -> "a x b"
a ^[x](a: True) b                  -> "a x b"
a ^[x](a: null) b                  -> "a x b"
a ^[x](a-b: 1) b                   -> "a x b"
a ^[x]($a: 1) b                    -> "a x b"
